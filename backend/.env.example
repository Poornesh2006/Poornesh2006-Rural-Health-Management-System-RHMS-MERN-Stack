NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rhms?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=https://your-rhms-frontend.onrender.com
FRONTEND_URL=https://your-rhms-frontend.onrender.com
APP_BASE_URL=https://your-rhms-api.onrender.com
LOG_LEVEL=info
EMAIL_PREVIEW_MODE=true
SMS_PROVIDER=mock
